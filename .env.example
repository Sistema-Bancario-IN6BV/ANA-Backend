# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (Sequelize)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ana_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_SQL_LOGGING=false

# MongoDB (Mongoose - ANA psychological analysis documents)
URI_MONGO=mongodb://localhost:27017/ana_db

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=
JWT_AUDIENCE=

# ANA IA-Engine (Python/FastAPI)
ANA_API_URL=http://localhost:8000

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=ANA

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_URL=
CLOUDINARY_FOLDER=ana
CLOUDINARY_DEFAULT_AVATAR_FILENAME=default-avatar.png
# CLOUDINARY_DEFAULT_AVATAR=

# File upload
UPLOAD_PATH=./uploads

# Security / IP filtering (comma-separated)
BLACKLISTED_IPS=
WHITELISTED_IPS=
RESTRICTED_PATHS=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# Verification token TTLs (hours)
VERIFICATION_EMAIL_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1
